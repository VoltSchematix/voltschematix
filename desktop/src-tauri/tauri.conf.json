{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VoltSchematix",
  "version": "1.0.3",
  "identifier": "io.github.voltschematix",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "VoltSchematix",
        "width": 1400,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "maximized": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "VoltSchematix",
    "copyright": "© 2026 VoltSchematix · MIT-licentie",
    "category": "Productivity",
    "shortDescription": "Plannen van een elektrische installatie tekenen",
    "longDescription": "VoltSchematix: eendraadschema, situatieplan, lijst met kringen en materiaallijst, samen in één PDF. Werkt volledig zonder internet.",
    "homepage": "https://voltschematix.github.io/voltschematix/",
    "license": "MIT",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["vsx"],
        "name": "VoltSchematix-project",
        "description": "VoltSchematix-project",
        "role": "Editor",
        "mimeType": "application/x-voltschematix"
      }
    ],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Dutch", "French", "English"],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico"
      }
    }
  }
}
